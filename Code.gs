// Новогодний барометр v2. Старые ответы сохраняются на прежней вкладке.
var HEADERS_=['ID','Версия','Получено','Регион','Банкет, ₽/гость','Фуршет, ₽/гость','Событийная доставка, ₽/гость','Изменение чека на декабрь, %','Причины изменения чека','Другое — причина','Запросы корпоративных клиентов на декабрь','Запросы частных гостей на декабрь','Изменение алкоголя на гостя в декабре','Версия анкеты'];
var REASONS_=['Стоимость продуктов','Оплата персонала','Логистика и оборудование','Изменение бюджета клиентов','Снижение спроса','Чек существенно не изменился','Другое'];
var ALCOHOL_=['Снизился','Примерно не изменился','Вырос','Алкоголь предоставляет заказчик, нет данных','Не работаем с такими мероприятиями'];
function setupV2(){var p=PropertiesService.getScriptProperties(),ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)ss=SpreadsheetApp.openById(p.getProperty('SPREADSHEET_ID'));var s=ss.getSheetByName('Ответы v2');if(!s)s=ss.insertSheet('Ответы v2');if(s.getLastRow()===0){s.appendRow(HEADERS_);s.setFrozenRows(1);s.getRange(1,1,1,HEADERS_.length).setFontWeight('bold').setBackground('#BE1419').setFontColor('#ffffff').setWrap(true);s.setRowHeight(1,65);s.setColumnWidths(1,HEADERS_.length,170);s.getRange('C2:C').setNumberFormat('dd.MM.yyyy HH:mm:ss');}p.setProperty('SPREADSHEET_ID',ss.getId());CacheService.getScriptCache().remove('statsV2');console.log('Анкета v2 готова. Вкладка: Ответы v2');}
function sheet_(){var id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw Error('Сначала выполните setupV2().');var s=SpreadsheetApp.openById(id).getSheetByName('Ответы v2');if(!s)throw Error('Сначала выполните setupV2().');return s;}
function safe_(v,n){return String(v==null?'':v).trim().slice(0,n||200);}
function textCell_(v,n){var s=safe_(v,n);return /^[=+@\-\t\r]/.test(s)?"'"+s:s;}
function numeric_(v,min,max){if(v===null||v===undefined||v==='')return '';if(typeof v!=='number'||!isFinite(v)||v<min||v>max)throw Error('Некорректное числовое значение.');return v;}
function doPost(e){var lock=LockService.getScriptLock(),p;try{var raw=e&&e.parameter&&e.parameter.payload||e&&e.postData&&e.postData.contents;if(!raw||raw.length>20000)throw Error('Некорректный запрос.');p=JSON.parse(raw);var a=p.answers||{};
if(p.schema!==2)throw Error('Обновите страницу: вопросы анкеты изменились.');if(!/^[a-f0-9-]{36}$/.test(p.id)||!/^[a-f0-9-]{36}$/.test(p.revision))throw Error('Некорректный ID.');
if(!safe_(a.region,160)||!safe_(a.corporate,3000)||!safe_(a.private,3000))throw Error('Заполните регион и ответы о запросах клиентов.');
if(!Array.isArray(a.reasons)||a.reasons.length<1||a.reasons.length>2||new Set(a.reasons).size!==a.reasons.length||a.reasons.some(function(i){return !Number.isInteger(i)||i<0||i>=REASONS_.length;}))throw Error('Выберите до двух причин.');if(a.reasons.indexOf(6)>=0&&!safe_(a.other,1500))throw Error('Заполните поле «Другое».');if(!Number.isInteger(a.alcohol)||!ALCOHOL_[a.alcohol])throw Error('Выберите ответ про алкоголь.');
var row=[p.id,p.revision,new Date(),textCell_(a.region,160),numeric_(a.banquet,0,1000000),numeric_(a.buffet,0,1000000),numeric_(a.delivery,0,1000000),numeric_(a.change,-100,500),a.reasons.map(function(i){return REASONS_[i];}).join(' | '),a.reasons.indexOf(6)>=0?textCell_(a.other,1500):'',textCell_(a.corporate,3000),textCell_(a.private,3000),ALCOHOL_[a.alcohol],2];
lock.waitLock(25000);var s=sheet_(),last=s.getLastRow(),ids=last>1?s.getRange(2,1,last-1,1).getValues():[],i=ids.findIndex(function(r){return r[0]===p.id;});s.getRange(i<0?last+1:i+2,1,1,row.length).setValues([row]);SpreadsheetApp.flush();CacheService.getScriptCache().remove('statsV2');return output_({ok:true});
}catch(err){if(p&&/^[a-f0-9-]{36}$/.test(p.revision))CacheService.getScriptCache().put('error_'+p.revision,err.message,120);return output_({ok:false,error:err.message});}finally{if(lock.hasLock())lock.releaseLock();}}
function output_(data,cb){var json=JSON.stringify(data).replace(/</g,'\\u003c').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');if(cb&&/^ch_[a-f0-9]+$/.test(cb))return ContentService.createTextOutput(cb+'('+json+');').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);}
function rows_(){var s=sheet_(),n=s.getLastRow();return n>1?s.getRange(2,1,n-1,14).getValues():[];}
function doGet(e){var p=e&&e.parameter||{};try{var result;if(!p.action||p.action==='ping'){sheet_();result={ok:true,schema:2};}else if(p.action==='receipt'){var error=CacheService.getScriptCache().get('error_'+p.revision);if(error)throw Error(error);result={ok:true,saved:rows_().some(function(r){return r[0]===p.id&&r[1]===p.revision;})};}else if(p.action==='stats'){var cache=CacheService.getScriptCache(),cached=cache.get('statsV2');if(cached)result=JSON.parse(cached);else{result=stats_(rows_());var json=JSON.stringify(result);if(json.length<80000)cache.put('statsV2',json,4);}}else throw Error('Неизвестный запрос.');return output_(result,p.callback);}catch(err){return output_({ok:false,error:err.message},p.callback);}}
function summary_(v){v=v.filter(function(n){return typeof n==='number'&&isFinite(n);}).sort(function(a,b){return a-b;});var n=v.length;return {n:n,mean:n?v.reduce(function(a,b){return a+b;},0)/n:null,median:n?(v[Math.floor((n-1)/2)]+v[Math.floor(n/2)])/2:null,min:n?v[0]:null,max:n?v[n-1]:null};}
function stats_(rows){var q={checks:{n:rows.filter(function(r){return [4,5,6].some(function(c){return typeof r[c]==='number';});}).length,fields:{}}};[['banquet',4],['buffet',5],['delivery',6]].forEach(function(pair){q.checks.fields[pair[0]]=summary_(rows.map(function(r){return r[pair[1]];}));});q.change=summary_(rows.map(function(r){return r[7];}));
[['region',3],['reasons',8],['alcohol',12]].forEach(function(pair){var counts=Object.create(null),n=0;rows.forEach(function(r){if(!r[pair[1]])return;n++;var vals=pair[0]==='reasons'?String(r[pair[1]]).split(' | '):[String(r[pair[1]])];vals.forEach(function(v){counts[v]=(counts[v]||0)+1;});});q[pair[0]]={n:n,counts:Object.keys(counts).map(function(k){return {label:k,count:counts[k]};}).sort(function(a,b){return b.count-a.count;})};});
[['corporate',10],['private',11]].forEach(function(pair){var all=rows.map(function(r){return String(r[pair[1]]||'');}).filter(Boolean);q[pair[0]]={n:all.length,texts:all.slice(-100)};});q.reasons.other=rows.map(function(r){return String(r[9]||'');}).filter(Boolean).slice(-100);return {ok:true,schema:2,total:rows.length,questions:q};}
